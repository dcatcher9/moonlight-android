<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Non-root application name -->
    <!-- FIXME: We should set extractNativeLibs=false but this breaks installation on the Fire TV 3 -->
    <application android:label="@string/app_label"
        android:isGame="true"
        android:appCategory="game"
        tools:targetApi="o">

        <!-- Android 12+ isolates vendor native libraries unless the app declares them.
             Galaxy XR publishes libOpenCL.so in /vendor/etc/public.libraries.txt; LiteRT's
             Cl/GL accelerator needs it in the app linker namespace for GPU inference. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
    </application>
</manifest>
