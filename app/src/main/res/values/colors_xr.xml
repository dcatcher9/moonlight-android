<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared palette for the XR surfaces: 16 base colours, plus semantic aliases and translucent
  interaction/compositing roles.

  Before this file the XR screens carried 54 distinct literals across 120 uses, most of them not
  deliberate: six near-identical darks all doing one job, two different error reds, 28 colours used
  once or twice.

  The first cut called all 24 role names separate colours even where aliases such as `scrim` and
  `on_accent` intentionally resolved to the same base, while also preserving near-duplicate base
  values such as `accent` and `accent_soft`. This file counts distinct opaque bases instead:
  aliases may name different jobs without inventing another hue, and translucent variants derive
  their RGB from a base. A token has to earn its place by naming a distinct job, not by matching a
  hex value someone once typed.

  These screens composite over passthrough or over video, so the palette is dark: large light areas
  glow in a headset and wash out what is behind them. One accent hue carries every
  selected/active/live meaning. Status colours are held away from that hue so "good" never reads as
  "selected", and destructive actions share the error red because an error and a delete are the same
  warning to the eye. Add here rather than inlining, and only when no existing token fits.
-->
<resources>
    <!-- Elevation. Three levels: the panel, a card on the panel, and the ground behind both.
         They sit close together on purpose; that closeness is depth, not drift. -->
    <color name="xr_surface">#FF16181E</color>
    <color name="xr_surface_raised">#FF22262B</color>
    <color name="xr_surface_sunken">#FF0C0F14</color>
    <!-- One token for every hairline: borders and dividers are the same visual job. -->
    <color name="xr_border">#FF3C4043</color>

    <!-- Accent. Three steps: the hue itself, a light form for text on dark, and a deep form for
         fills, pressed states and borders. -->
    <color name="xr_accent">#FF8AB4F8</color>
    <color name="xr_accent_bright">#FFD7E5FF</color>
    <color name="xr_accent_deep">#FF36587F</color>

    <!-- Text. Three weights; a fourth stopped being distinguishable at arm's length. -->
    <color name="xr_text_primary">#FFFFFFFF</color>
    <color name="xr_text_secondary">#FFB0B9C6</color>
    <color name="xr_text_disabled">#FF71808F</color>

    <!-- Semantic. Deliberately off the accent hue. -->
    <color name="xr_status_ok">#FF5CD65C</color>
    <color name="xr_status_warn">#FFE0B020</color>
    <!-- Errors and destructive actions share a red: to the eye both mean "stop and read this". -->
    <color name="xr_danger">#FFFFB4AB</color>
    <color name="xr_danger_container">#FF6D3A3E</color>

    <!-- Role aliases. Not new colours: they let a widget read as its job rather than as a hue. -->
    <color name="xr_on_accent">@color/xr_surface_sunken</color>
    <color name="xr_scrim">@color/xr_surface_sunken</color>
    <color name="xr_segment_filled">@color/xr_accent</color>
    <color name="xr_segment_empty">@color/xr_border</color>
    <color name="xr_segment_disabled">@color/xr_surface_raised</color>

    <!-- Border tones for raised chrome. Bluer than xr_border, which is the neutral hairline;
         these tie a tile or panel edge to the accent without drawing as a line of its own. -->
    <color name="xr_border_tile">#FF455466</color>
    <color name="xr_border_panel">#FF34485D</color>

    <!-- Alpha variants are named for their compositing job. Their RGB always comes from one of
         the base roles above, so translucent chrome does not create another near-duplicate hue. -->
    <color name="xr_panel_surface">#F216181E</color>
    <color name="xr_surface_raised_80">#CC22262B</color>
    <color name="xr_surface_raised_90">#E622262B</color>
    <color name="xr_accent_pressed_overlay">#338AB4F8</color>
    <color name="xr_accent_focus_overlay">#268AB4F8</color>
    <color name="xr_scrim_strong">#E60C0F14</color>
    <color name="xr_scrim_medium">#800C0F14</color>
    <color name="xr_scrim_clear">#000C0F14</color>
    <color name="xr_shadow_strong">#CC0C0F14</color>
</resources>
