<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pc_card_standard"
    android:layout_width="@dimen/xr_pc_grid_card_width"
    android:layout_height="@dimen/xr_pc_grid_card_height"
    android:background="@drawable/xr_home_card_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/xr_space_lg">

    <RelativeLayout
        android:id="@+id/grid_image_layout"
        android:layout_width="96dp"
        android:layout_height="96dp">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_centerInParent="true"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_centerInParent="true"
            android:indeterminate="true" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/xr_space_md"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_emphasis"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/grid_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:textColor="@color/xr_text_secondary"
            android:textSize="@dimen/xr_text_caption" />

        <Button
            android:id="@+id/grid_primary_action"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/xr_control_standard"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:background="@drawable/xr_home_primary_action_background"
            app:backgroundTint="@null"
            android:minWidth="126dp"
            android:minHeight="@dimen/xr_control_standard"
            android:paddingStart="@dimen/xr_space_md"
            android:paddingEnd="@dimen/xr_space_md"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_body" />
    </LinearLayout>

    <Button
        android:id="@+id/grid_more_button"
        android:layout_width="@dimen/xr_control_standard"
        android:layout_height="@dimen/xr_control_standard"
        android:layout_gravity="center_vertical"
        android:background="@drawable/xr_home_action_background"
        app:backgroundTint="@null"
        android:gravity="center"
        android:minWidth="@dimen/xr_control_standard"
        android:minHeight="@dimen/xr_control_standard"
        android:padding="0dp"
        android:singleLine="true"
        android:text="@string/xr_setting_plus"
        android:textAllCaps="false"
        android:textColor="@color/xr_text_primary"
        android:textSize="@dimen/xr_text_display" />
</LinearLayout>
