<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pc_card_hero"
    android:layout_width="@dimen/xr_pc_hero_card_width"
    android:layout_height="@dimen/xr_pc_hero_card_height"
    android:background="@drawable/xr_home_card_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/xr_space_xl">

    <RelativeLayout
        android:id="@+id/grid_image_layout"
        android:layout_width="132dp"
        android:layout_height="132dp">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:contentDescription="@null" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:indeterminate="true" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/xr_space_xl"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/xr_home_single_machine_label"
            android:textColor="@color/xr_accent"
            android:textSize="@dimen/xr_text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/grid_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:textColor="@color/xr_text_secondary"
            android:textSize="@dimen/xr_text_emphasis"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/grid_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:maxLines="2"
            android:textColor="#FFB7C9DA"
            android:textSize="@dimen/xr_text_body" />

        <Button
            android:id="@+id/grid_primary_action"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/xr_control_standard"
            android:layout_marginTop="@dimen/xr_space_md"
            android:background="@drawable/xr_home_primary_action_background"
            android:minWidth="150dp"
            android:paddingStart="@dimen/xr_space_lg"
            android:paddingEnd="@dimen/xr_space_lg"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_emphasis"
            app:backgroundTint="@null" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="154dp"
        android:layout_marginStart="@dimen/xr_space_lg"
        android:layout_marginEnd="@dimen/xr_space_lg"
        android:background="@color/xr_accent_deep" />

    <LinearLayout
        android:layout_width="216dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/xr_home_host_details"
            android:textColor="#FF829AB1"
            android:textSize="@dimen/xr_text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/grid_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFE7EDF4"
            android:textSize="@dimen/xr_text_body" />

        <LinearLayout
            android:id="@+id/grid_connection_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xr_home_headset_wifi"
                android:textColor="#FF829AB1"
                android:textSize="@dimen/xr_text_caption"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/grid_connection_speed_values"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="30dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/grid_download_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFB7C9DA"
                    android:textSize="@dimen/xr_text_emphasis" />

                <TextView
                    android:id="@+id/grid_upload_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/xr_space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="#FFB7C9DA"
                    android:textSize="@dimen/xr_text_emphasis" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/grid_display_fact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:maxLines="2"
            android:textColor="#FFE7EDF4"
            android:textSize="@dimen/xr_text_body" />

        <TextView
            android:id="@+id/grid_session_fact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_sm"
            android:maxLines="2"
            android:textColor="#FFE7EDF4"
            android:textSize="@dimen/xr_text_body" />
    </LinearLayout>

    <Button
        android:id="@+id/grid_more_button"
        android:layout_width="60dp"
        android:layout_height="@dimen/xr_control_standard"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/xr_space_md"
        android:background="@drawable/xr_home_action_background"
        android:gravity="center"
        android:minWidth="60dp"
        android:minHeight="@dimen/xr_control_standard"
        android:padding="0dp"
        android:singleLine="true"
        android:text="@string/xr_setting_plus"
        android:textAllCaps="false"
        android:textColor="@color/xr_text_primary"
        android:textSize="@dimen/xr_text_display"
        app:backgroundTint="@null" />
</LinearLayout>
