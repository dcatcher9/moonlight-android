<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D1117"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".PcView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="Artemis" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/xr_home_subtitle"
                android:textColor="#FF9FB3C8"
                android:textSize="19sp" />
        </LinearLayout>

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:minWidth="144dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/xr_home_settings"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/helpButton"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:minWidth="112dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/help"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/manuallyAddPc"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/xr_home_primary_action_background"
            app:backgroundTint="@null"
            android:minWidth="172dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/xr_home_add_computer"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeConnectionStage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/xr_home_card_background"
        android:gravity="center_vertical"
        android:minHeight="104dp"
        android:orientation="horizontal"
        android:padding="18dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/homeConnectionStageProgress"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="18dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeConnectionStageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeConnectionStageDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#FFBDC1C6"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/homeConnectionStageDismiss"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/dismiss"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/machineSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="@string/xr_bar_machines"
        android:textColor="#FF9AC7FF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/xr_home_panel_background"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:maxWidth="520dp"
                android:text="@string/searching_pc"
                android:textColor="#FFDADCE0"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
