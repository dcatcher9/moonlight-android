<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xr_surface_sunken"
    android:orientation="vertical"
    android:padding="@dimen/xr_space_xl"
    tools:context=".preferences.StreamSettings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/xr_space_lg">

        <!-- An ImageButton, not a Button with a drawableStart: a compound drawable is positioned
             relative to the text, so on a text-less button it lays out beside an empty string and
             is clipped by the padding, leaving the button looking blank. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/settingsBackFab"
            android:layout_width="@dimen/xr_control_primary"
            android:layout_height="@dimen/xr_control_standard"
            android:background="@drawable/xr_home_action_background"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/xr_space_md"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/xr_space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xr_global_settings_title"
                android:textColor="@color/xr_text_primary"
                android:textSize="@dimen/xr_text_display"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_space_xs"
                android:text="@string/xr_global_settings_summary"
                android:textColor="@color/xr_text_secondary"
                android:textSize="@dimen/xr_text_body" />

            <TextView
                android:id="@+id/settingsAttribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_space_xs"
                android:textColor="@color/xr_text_secondary"
                android:textSize="@dimen/xr_text_caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="248dp"
            android:layout_height="match_parent"
            android:background="@drawable/xr_home_panel_background"
            android:orientation="vertical"
            android:padding="@dimen/xr_space_md">

            <Button
                android:id="@+id/settingsStreaming"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_streaming_defaults" />

            <Button
                android:id="@+id/settingsAudioInput"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_audio_input" />

            <Button
                android:id="@+id/settingsGeneral"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_general" />

            <Button
                android:id="@+id/settingsDiagnostics"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_diagnostics" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settings_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/xr_space_lg"
            android:layout_weight="1"
            android:background="@drawable/xr_home_panel_background"
            android:padding="@dimen/xr_space_md" />
    </LinearLayout>
</LinearLayout>
