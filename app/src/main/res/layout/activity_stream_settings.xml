<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121316"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".preferences.StreamSettings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <Button
            android:id="@+id/settingsBackFab"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:contentDescription="@string/action_back"
            android:drawableStart="@drawable/ic_arrow_back"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xr_global_settings_title"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/xr_global_settings_summary"
                android:textColor="#FFBDC1C6"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="248dp"
            android:layout_height="match_parent"
            android:background="@drawable/xr_home_panel_background"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/settingsStreaming"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_streaming_defaults" />

            <Button
                android:id="@+id/settingsAudioInput"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_audio_input" />

            <Button
                android:id="@+id/settingsGeneral"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_general" />

            <Button
                android:id="@+id/settingsDiagnostics"
                style="@style/XrSettingsNavButton"
                android:text="@string/category_xr_diagnostics" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settings_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:background="@drawable/xr_home_panel_background"
            android:padding="10dp" />
    </LinearLayout>
</LinearLayout>
