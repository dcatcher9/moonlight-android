<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121316"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".preferences.AddComputerManually">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addPcBackButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:contentDescription="@string/action_back"
            android:drawableStart="@drawable/ic_arrow_back"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:minHeight="56dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/manuallyAddPcText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xr_connection_title"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/xr_connection_subtitle"
                android:textColor="#FFBDC1C6"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/xr_home_panel_background"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xr_connection_address"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hostTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/xr_home_action_background"
                android:hint="@string/ip_hint"
                android:inputType="textNoSuggestions"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:minHeight="64dp"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF9AA0A6"
                android:textSize="18sp">

                <requestFocus />
            </EditText>

            <Button
                android:id="@+id/addPcButton"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/xr_home_primary_action_background"
                app:backgroundTint="@null"
                android:text="@string/xr_connection_connect"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:minHeight="64dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/xr_home_card_background"
            android:gravity="center_vertical"
            android:minHeight="104dp"
            android:orientation="horizontal"
            android:padding="18dp">

            <ProgressBar
                android:id="@+id/connectionProgress"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="18dp"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/connectionStageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Ready" />

                <TextView
                    android:id="@+id/connectionStageDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#FFBDC1C6"
                    android:textSize="16sp"
                    tools:text="Enter the address shown by Apollo or Sunshine." />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
