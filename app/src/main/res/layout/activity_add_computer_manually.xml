<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xr_surface_sunken"
    android:orientation="vertical"
    android:padding="@dimen/xr_space_xl"
    tools:context=".preferences.AddComputerManually">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addPcBackButton"
            android:layout_width="@dimen/xr_control_primary"
            android:layout_height="wrap_content"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:contentDescription="@string/action_back"
            android:drawableStart="@drawable/ic_arrow_back"
            android:paddingStart="@dimen/xr_space_lg"
            android:paddingEnd="@dimen/xr_space_lg"
            android:minHeight="@dimen/xr_control_standard" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/xr_space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/manuallyAddPcText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xr_connection_title"
                android:textColor="@color/xr_text_primary"
                android:textSize="@dimen/xr_text_display"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_space_xs"
                android:text="@string/xr_connection_subtitle"
                android:textColor="@color/xr_text_secondary"
                android:textSize="@dimen/xr_text_body" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/xr_home_panel_background"
        android:orientation="vertical"
        android:padding="@dimen/xr_space_xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xr_connection_address"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_emphasis"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hostTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/xr_home_action_background"
                android:hint="@string/ip_hint"
                android:inputType="textNoSuggestions"
                android:paddingStart="@dimen/xr_space_lg"
                android:paddingEnd="@dimen/xr_space_lg"
                android:minHeight="@dimen/xr_control_primary"
                android:singleLine="true"
                android:textColor="@color/xr_text_primary"
                android:textColorHint="@color/xr_text_disabled"
                android:textSize="@dimen/xr_text_emphasis">

                <requestFocus />
            </EditText>

            <Button
                android:id="@+id/addPcButton"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/xr_space_md"
                android:background="@drawable/xr_home_primary_action_background"
                app:backgroundTint="@null"
                android:text="@string/xr_connection_connect"
                android:textAllCaps="false"
                android:textColor="@color/xr_text_primary"
                android:textSize="@dimen/xr_text_body"
                android:minHeight="@dimen/xr_control_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xr_space_xl"
            android:background="@drawable/xr_home_card_background"
            android:gravity="center_vertical"
            android:minHeight="104dp"
            android:orientation="horizontal"
            android:padding="@dimen/xr_space_lg">

            <ProgressBar
                android:id="@+id/connectionProgress"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="@dimen/xr_space_lg"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/connectionStageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/xr_text_primary"
                    android:textSize="@dimen/xr_text_emphasis"
                    android:textStyle="bold"
                    tools:text="Ready" />

                <TextView
                    android:id="@+id/connectionStageDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/xr_space_xs"
                    android:textColor="@color/xr_text_secondary"
                    android:textSize="@dimen/xr_text_body"
                    tools:text="Enter the address shown by Sunshine 3D or Sunshine." />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
