<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/xr_space_lg"
    android:paddingTop="@dimen/xr_space_md"
    android:paddingEnd="@dimen/xr_space_lg"
    android:paddingBottom="@dimen/xr_space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="@dimen/xr_icon_inline"
            android:layout_height="@dimen/xr_icon_inline"
            android:layout_marginEnd="@dimen/xr_space_sm"
            android:contentDescription="@null" />

        <TextView
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_emphasis"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/xr_seekbar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/xr_space_lg"
            android:gravity="end"
            android:minWidth="80dp"
            android:textColor="@color/xr_accent_bright"
            android:textSize="@dimen/xr_text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xr_space_xs"
        android:textColor="@color/xr_text_secondary"
        android:textSize="@dimen/xr_text_caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xr_space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/xr_seekbar_decrease"
            style="@style/XrStepButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/xr_setting_decrease"
            android:text="@string/xr_setting_minus" />

        <SeekBar
            android:id="@+id/xr_seekbar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/xr_space_md"
            android:layout_marginEnd="@dimen/xr_space_md"
            android:layout_weight="1"
            android:focusable="true"
            android:progressBackgroundTint="@color/xr_border"
            android:progressTint="@color/xr_accent"
            android:splitTrack="false"
            android:thumbTint="@color/xr_accent_bright" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/xr_seekbar_increase"
            style="@style/XrStepButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/xr_setting_increase"
            android:text="@string/xr_setting_plus" />
    </LinearLayout>
</LinearLayout>
