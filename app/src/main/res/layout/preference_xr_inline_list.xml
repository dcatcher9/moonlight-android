<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/xr_space_lg"
    android:paddingTop="@dimen/xr_space_md"
    android:paddingEnd="@dimen/xr_space_lg"
    android:paddingBottom="@dimen/xr_space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="@dimen/xr_icon_inline"
            android:layout_height="@dimen/xr_icon_inline"
            android:layout_marginEnd="@dimen/xr_space_sm"
            android:contentDescription="@null" />

        <TextView
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_emphasis"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xr_space_xs"
        android:textColor="@color/xr_text_secondary"
        android:textSize="@dimen/xr_text_caption" />

    <com.limelight.preferences.XrChoiceGroup
        android:id="@+id/xr_choice_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xr_space_md" />

    <com.limelight.ui.xrcontrols.XrResolutionSelector
        android:id="@+id/xr_resolution_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xr_space_md"
        android:visibility="gone" />
</LinearLayout>
