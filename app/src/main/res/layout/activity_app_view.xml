<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xr_surface_sunken"
    android:orientation="vertical"
    android:padding="@dimen/xr_space_xl"
    tools:context=".AppView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/xr_space_lg">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawablePadding="@dimen/xr_space_md"
            android:minWidth="144dp"
            android:minHeight="@dimen/xr_control_standard"
            android:paddingStart="@dimen/xr_space_lg"
            android:paddingEnd="@dimen/xr_space_lg"
            android:text="@string/xr_bar_machines"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_body" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/xr_space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xr_text_primary"
                android:textSize="@dimen/xr_text_display"
                android:textStyle="bold"
                tools:text="Gaming PC" />

            <TextView
                android:id="@+id/computerStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_space_xs"
                android:text="@string/pcview_menu_header_online"
                android:textColor="@color/xr_status_ok"
                android:textSize="@dimen/xr_text_caption" />
        </LinearLayout>

        <SearchView
            android:id="@+id/appSearch"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/xr_space_md"
            android:background="@drawable/xr_home_action_background"
            android:iconifiedByDefault="false"
            android:maxWidth="240dp"
            android:minHeight="@dimen/xr_control_standard"
            android:paddingStart="@dimen/xr_space_sm"
            android:paddingEnd="@dimen/xr_space_sm"
            android:queryHint="@string/xr_home_apps" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/xr_space_md"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:minWidth="128dp"
            android:minHeight="@dimen/xr_control_standard"
            android:paddingStart="@dimen/xr_space_lg"
            android:paddingEnd="@dimen/xr_space_lg"
            android:text="@string/xr_home_settings"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_body" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/currentSessionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/xr_space_lg"
        android:background="@drawable/xr_home_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/xr_space_lg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xr_home_current_session"
                android:textColor="@color/xr_accent"
                android:textSize="@dimen/xr_text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentSessionAppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xr_text_primary"
                android:textSize="@dimen/xr_text_emphasis"
                tools:text="Cyberpunk 2077" />
        </LinearLayout>

        <Button
            android:id="@+id/resumeSessionButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/xr_control_standard"
            android:layout_marginStart="@dimen/xr_space_lg"
            android:background="@drawable/xr_home_primary_action_background"
            app:backgroundTint="@null"
            android:minWidth="140dp"
            android:paddingStart="@dimen/xr_space_lg"
            android:paddingEnd="@dimen/xr_space_lg"
            android:text="@string/applist_menu_resume"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="@dimen/xr_text_body" />

        <Button
            android:id="@+id/endSessionButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/xr_control_standard"
            android:layout_marginStart="@dimen/xr_space_md"
            android:background="@drawable/xr_home_destructive_action_background"
            app:backgroundTint="@null"
            android:minWidth="132dp"
            android:paddingStart="@dimen/xr_space_lg"
            android:paddingEnd="@dimen/xr_space_lg"
            android:text="@string/xr_home_end_session"
            android:textAllCaps="false"
            android:textColor="@color/xr_danger"
            android:textSize="@dimen/xr_text_body" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/xr_space_md"
        android:text="@string/xr_home_apps"
        android:textColor="@color/xr_text_secondary"
        android:textSize="@dimen/xr_text_title"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/xr_home_panel_background"
        android:padding="@dimen/xr_space_md" />
</LinearLayout>
