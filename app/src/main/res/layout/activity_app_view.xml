<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121316"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".AppView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:drawableStart="@drawable/ic_arrow_back"
            android:drawablePadding="10dp"
            android:minWidth="144dp"
            android:minHeight="56dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/xr_bar_machines"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xr_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Gaming PC" />

            <TextView
                android:id="@+id/computerStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/pcview_menu_header_online"
                android:textColor="@color/xr_status_ok"
                android:textSize="15sp" />
        </LinearLayout>

        <SearchView
            android:id="@+id/appSearch"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/xr_home_action_background"
            android:iconifiedByDefault="false"
            android:maxWidth="240dp"
            android:minHeight="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:queryHint="@string/xr_home_apps" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:minWidth="128dp"
            android:minHeight="56dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/xr_home_settings"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/currentSessionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/xr_home_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xr_home_current_session"
                android:textColor="@color/xr_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentSessionAppText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xr_text_primary"
                android:textSize="21sp"
                tools:text="Cyberpunk 2077" />
        </LinearLayout>

        <Button
            android:id="@+id/resumeSessionButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/xr_home_primary_action_background"
            app:backgroundTint="@null"
            android:minWidth="140dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/applist_menu_resume"
            android:textAllCaps="false"
            android:textColor="@color/xr_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/endSessionButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/xr_home_destructive_action_background"
            app:backgroundTint="@null"
            android:minWidth="132dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/xr_home_end_session"
            android:textAllCaps="false"
            android:textColor="@color/xr_danger"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="@string/xr_home_apps"
        android:textColor="@color/xr_text_secondary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/xr_home_panel_background"
        android:padding="12dp" />
</LinearLayout>
