<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/xr_app_card_width"
    android:layout_height="388dp"
    android:background="@drawable/xr_home_card_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/grid_primary_action"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <RelativeLayout
                android:id="@+id/grid_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/grid_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:padding="12dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/grid_overlay"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null" />
            </RelativeLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/grid_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/grid_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF8AB4F8"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grid_action_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/grid_resume_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/xr_home_primary_action_background"
            app:backgroundTint="@null"
            android:contentDescription="@string/applist_menu_resume"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="56dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/xr_home_resume_short"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/grid_quit_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/xr_home_destructive_action_background"
            app:backgroundTint="@null"
            android:contentDescription="@string/applist_menu_quit"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="56dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/xr_home_quit_short"
            android:textAllCaps="false"
            android:textColor="#FFFFB4AB"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/grid_more_button"
            android:layout_width="@dimen/xr_app_card_more_width"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/xr_home_action_background"
            app:backgroundTint="@null"
            android:contentDescription="@string/xr_home_more"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="56dp"
            android:minWidth="@dimen/xr_app_card_more_width"
            android:padding="0dp"
            android:singleLine="true"
            android:text="@string/xr_home_more_symbol"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
