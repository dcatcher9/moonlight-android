<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#CC22262B" />
            <stroke android:width="1dp" android:color="#FF3C4043" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF82494C" />
            <stroke android:width="2dp" android:color="#FFFFDAD6" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#FF6D3A3E" />
            <stroke android:width="3dp" android:color="#FFFFB4AB" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <solid android:color="#FF6D3A3E" />
            <stroke android:width="3dp" android:color="#FFFFB4AB" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E622262B" />
            <stroke android:width="1dp" android:color="#FF5F6368" />
        </shape>
    </item>
</selector>
