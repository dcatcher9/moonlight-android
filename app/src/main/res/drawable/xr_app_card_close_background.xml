<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/xr_surface_raised_80" />
            <stroke android:width="1dp" android:color="@color/xr_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/xr_danger_container" />
            <stroke android:width="2dp" android:color="@color/xr_danger" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/xr_danger_container" />
            <stroke android:width="3dp" android:color="@color/xr_danger" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <solid android:color="@color/xr_danger_container" />
            <stroke android:width="3dp" android:color="@color/xr_danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/xr_surface_raised_90" />
            <stroke android:width="1dp" android:color="@color/xr_text_disabled" />
        </shape>
    </item>
</selector>
