<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/xr_border" />
            <corners android:radius="@dimen/xr_radius_card" />
            <stroke android:width="3dp" android:color="@color/xr_accent" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="@color/xr_border" />
            <corners android:radius="@dimen/xr_radius_card" />
            <stroke android:width="3dp" android:color="@color/xr_accent" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/xr_accent_deep" />
            <corners android:radius="@dimen/xr_radius_card" />
            <stroke android:width="2dp" android:color="@color/xr_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/xr_radius_card" />
        </shape>
    </item>
</selector>
