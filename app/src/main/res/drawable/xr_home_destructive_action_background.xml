<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#FF2D292A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF4B4142" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FF82494C" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFDAD6" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF6D3A3E" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FFFFB4AB" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="#FF6D3A3E" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FFFFB4AB" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF4B2C2F" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF9A6566" />
        </shape>
    </item>
</selector>
