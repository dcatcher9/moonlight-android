<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#FF22262B" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF3C4043" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FF547DB8" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFD7E5FF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF36587F" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FF8AB4F8" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="#FF36587F" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FF8AB4F8" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF30343A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF5F6368" />
        </shape>
    </item>
</selector>
