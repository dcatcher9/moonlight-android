<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#334C79B8" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#8AB4F8" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#263C5A80" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#8AB4F8" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="#263C5A80" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#8AB4F8" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF24262B" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#FF45484F" />
        </shape>
    </item>
</selector>
