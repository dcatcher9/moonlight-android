+bool LiIsStreamGammaSupported(void) {
+    return StreamGammaVersion == 1 && packetTypes == packetTypesGen7Enc &&
+        ListenerCallbacks.streamGammaAck != NULL;
+}
+
+int LiSendStreamGamma(uint8_t mode, uint32_t requestId) {
+    BYTE_BUFFER bb;
+    uint8_t payload[8];
+    if (!LiIsStreamGammaSupported() || mode > 2 || requestId == 0) {
+        return -1;
+    }
+    BbInitializeWrappedBuffer(&bb, (char*)payload, 0, sizeof(payload), BYTE_ORDER_LITTLE);
+    BbPut8(&bb, 1);
+    BbPut8(&bb, mode);
+    BbPut16(&bb, 0);
+    BbPut32(&bb, requestId);
+    return sendMessageAndForget(0x300C, sizeof(payload), payload,
+        CTRL_CHANNEL_SERVERCTL, ENET_PACKET_FLAG_RELIABLE, false);
+}
