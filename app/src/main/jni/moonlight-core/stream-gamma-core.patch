+extern unsigned int StreamGammaVersion;
+
+// Independent extension negotiation is exact and unambiguous; the legacy numeric SDP helper
+// accepts numeric prefixes and is intentionally not used for this capability.
+static inline bool supportsStreamGammaV1Sdp(const char* payload) {
+    const char prefix[] = "a=x-ss-video.streamGammaVersion:";
+    const size_t prefixLength = sizeof(prefix) - 1;
+    unsigned int matches = 0;
+    bool versionOne = false;
+    if (payload == NULL) return false;
+    while (*payload) {
+        const char* end = strchr(payload, '\n');
+        size_t length = end != NULL ? (size_t)(end - payload) : strlen(payload);
+        if (length && payload[length - 1] == '\r') length--;
+        if (length >= prefixLength && memcmp(payload, prefix, prefixLength) == 0) {
+            matches++;
+            versionOne = length == prefixLength + 1 && payload[prefixLength] == '1';
+        }
+        if (end == NULL) break;
+        payload = end + 1;
+    }
+    return matches == 1 && versionOne;
+}
