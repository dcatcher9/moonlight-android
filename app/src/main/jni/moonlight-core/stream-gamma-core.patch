+static bool dispatchStreamGammaAck(PNVCTL_ENET_PACKET_HEADER_V1 packet, int packetLength) {
+    if (packet->type != 0x300D) {
+        return false;
+    }
+    if (!LiIsStreamGammaSupported() || ListenerCallbacks.streamGammaAck == NULL) {
+        return true;
+    }
+    const uint8_t* payload = (const uint8_t*)(packet + 1);
+    if (packetLength != (int)sizeof(*packet) + 16 || payload[0] != 1 ||
+            payload[1] > 3 || payload[2] > 2 || payload[3] > 2 ||
+            (payload[1] == 0 && payload[2] != payload[3])) {
+        return true;
+    }
+    BYTE_BUFFER bb;
+    uint32_t requestId, generation, whiteBits;
+    float whiteNits;
+    BbInitializeWrappedBuffer(&bb, (char*)payload, 4, 12, BYTE_ORDER_LITTLE);
+    BbGet32(&bb, &requestId);
+    BbGet32(&bb, &generation);
+    BbGet32(&bb, &whiteBits);
+    memcpy(&whiteNits, &whiteBits, sizeof(whiteNits));
+    if (generation == 0 || !isfinite(whiteNits) || whiteNits < 40 || whiteNits > 1000) {
+        return true;
+    }
+    ListenerCallbacks.streamGammaAck(payload[1], payload[2], payload[3],
+        requestId, generation, whiteNits);
+    return true;
+}
